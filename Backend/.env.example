# ---------------------------------------------------------------
# FoodDelivery backend configuration.
# Copy to .env for local development. NEVER commit a real .env.
# On Render these are set by render.yaml / the dashboard instead.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database --------------------------------------------------
# Option 1 (used on Render): one connection string.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Option 2 (local): individual settings.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# true when the database requires TLS (e.g. Render's *external* URL).
# Render's internal URL does not need it.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10

# Create tables automatically when the database is empty (never touches
# an existing database). Set to false to disable.
DB_AUTO_INIT=true

# --- Auth ------------------------------------------------------
# At least 32 random characters in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
# Admin and super-admin sessions expire sooner than other roles.
# JWT_ADMIN_EXPIRES_IN=12h

# First admin account, created on startup only if it does not exist yet.
# Remove ADMIN_PASSWORD from the environment after the first successful start.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=at-least-8-characters
# ADMIN_FIRST_NAME=Platform
# ADMIN_LAST_NAME=Admin

# Super-admin account (single break-glass account, seeded on first startup).
# Initial credentials are forced to change at first sign-in.
# To recover/rotate an existing super-admin password, set the same account
# email plus a new 16+ character password and set the flag below to true.
# Deploy/restart once, then REMOVE the flag immediately so later restarts
# do not reapply the bootstrap password.
# SUPER_ADMIN_EMAIL=owner@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-strong-16-character-or-longer-secret
# SUPER_ADMIN_FIRST_NAME=Platform
# SUPER_ADMIN_LAST_NAME=Super Admin
# SUPER_ADMIN_FORCE_PASSWORD_RESET=true

# --- Web -------------------------------------------------------
# Only needed if the frontend is served from a DIFFERENT origin than the
# API. Comma-separated exact origins. Same-origin never needs this.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Number of reverse proxies in front of the app (Render: 1). Controls
# which IP rate limiting sees. See DEPLOY_RENDER.md.
# TRUST_PROXY=1

# Rate limits (per IP, 15 minute window unless noted)
# RATE_LIMIT_MAX=1000
# LOGIN_IP_MAX=100
# LOGIN_ACCOUNT_MAX=10
# LOGIN_EMAIL_MAX=30         (failed logins per account from any address)
# REGISTER_MAX=20            (per hour)
# JSON_BODY_LIMIT=100kb

DASHBOARD_TIME_ZONE=Africa/Nairobi

# --- Transactional email (Brevo HTTPS API; SMTP ports are not used) ----
# Create a Brevo API key and verify the sender email/domain in Brevo.
# BREVO_API_KEY=
# EMAIL_FROM=verified-sender@example.com
# EMAIL_FROM_NAME=Food Delivery
